# Frontend (Vite) environment. Copy to .env.local. Only VITE_* variables reach the browser.
# Never put secrets (service role key, SERVICE_TOKEN, API keys) here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE=/api
# true = run on MSW mocks with a role picker on the login page (no backend needed)
VITE_USE_MOCKS=false
