# One env file for the whole repo: copy this to `.env` (git-ignored) and fill it in.
# The Python backend, Vite (only VITE_* reach the browser) and scripts/warmup.py all read it.
# SECRETS: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL, SERVICE_TOKEN, the LLM keys. Never commit or paste them.

# Supabase (Database & Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE=/api
VITE_USE_MOCKS=false

# Node API & Services
AI_SERVICE_URL=
SERVICE_TOKEN=

# LLM Providers (Hugging Face Space)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Document & Embedding Models
EMBED_MODEL=BAAI/bge-small-en-v1.5
OCR_ENGINE=rapidocr
LOG_LEVEL=INFO
